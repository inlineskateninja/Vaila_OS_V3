LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=auto
LMSTUDIO_TIMEOUT_SECONDS=120

# Remote web access safety.
# Leave VAILA_WEB_AUTH_TOKEN blank for local-only development.
# Set VAILA_REMOTE_ACCESS_ENABLED=true and a long random token before exposing
# Vaila through Tailscale Serve, Cloudflare Tunnel, or any remote proxy.
VAILA_REMOTE_ACCESS_ENABLED=false
VAILA_WEB_AUTH_TOKEN=
VAILA_ALLOWED_ORIGINS=
VAILA_SERVER_HOST=127.0.0.1
VAILA_SERVER_PORT=8765

N8N_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=60

OPENBRAIN_ENABLED=false
OPENBRAIN_MODE=disabled
OPENBRAIN_BASE_URL=
OPENBRAIN_API_KEY=
OPENBRAIN_LOCAL_STORE_PATH=
OPENBRAIN_TIMEOUT_SECONDS=60

VAILA_REMOTE_ACCESS_ENABLED=true
VAILA_WEB_AUTH_TOKEN=replace-with-a-long-random-token
VAILA_ALLOWED_ORIGINS=
VAILA_SERVER_HOST=127.0.0.1
VAILA_SERVER_PORT=8765