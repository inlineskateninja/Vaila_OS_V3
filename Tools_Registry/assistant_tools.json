    {
      "tool_id": "google_calendar",
      "display_name": "Google Calendar",
      "service_id": "google",
      "enabled": false,
      "module": "Assistant_Tools.google_calendar",
      "description": "Read, search, create, update, and summarize calendar events after Google OAuth is configured.",
      "actions": ["list_events", "search_events", "create_event", "update_event", "delete_event", "summarize_schedule"],
      "risk_levels": {
        "list_events": "medium",
        "search_events": "medium",
        "create_event": "high",
        "update_event": "high",
        "delete_event": "critical",
        "summarize_schedule": "medium"
      },
      "approval_required_actions": ["create_event", "update_event", "delete_event"],
      "voice_enabled": true,
      "text_enabled": true,
      "example_prompts": [
        "What is on my calendar today?",
        "Schedule a 30 minute focus block tomorrow afternoon.",
        "Move my dentist appointment to next Friday if there is an opening."
      ]
    },
